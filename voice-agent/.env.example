# Vapi account: https://dashboard.vapi.ai -> Settings -> API Keys
VAPI_PRIVATE_KEY=

# Company/brand info injected into every agent's prompt
COMPANY_NAME=Acme Co
COMPANY_HOURS=Mon-Fri 9am-6pm ET
SUPPORT_EMAIL=support@example.com

# Optional: phone number ID to attach the workflow to (created in Vapi dashboard
# or via the Vapi phone number API once you've bought/imported a number)
VAPI_PHONE_NUMBER_ID=

# Webhook server (server/webhook.js)
WEBHOOK_PORT=8787
# Public URL Vapi should POST end-of-call reports to, e.g. an ngrok tunnel
# (https://xxxx.ngrok.app/vapi/webhook) or your deployed server's public URL.
# Leave blank to deploy agents without call logging wired up.
WEBHOOK_URL=
# Shared secret sent back by Vapi in the x-vapi-secret header, used by
# server/webhook.js to verify inbound requests actually came from Vapi
VAPI_WEBHOOK_SECRET=
